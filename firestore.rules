// Firestore のルール（Firebase コンソール → Firestore Database → ルール に貼り付けて公開する）
// 「あなたのメールアドレス」を、このアプリ専用のアカウントのメールアドレスに書き換える。
// このルールで、そのアカウント以外は shift/main を読み書きできない。
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /shift/main {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'あなたのメールアドレス';
    }
  }
}
